#!/usr/bin/env zsh

# Usage: gcloud-secret-edit SECRET_NAME [PROJECT_ID]

secret_name="$1"
project_id="$2"

if [[ -z "$secret_name" ]]; then
  echo "Usage: gcloud-secret-edit SECRET_NAME [PROJECT_ID]"
  exit 1
fi

temp_file=$(mktemp)
trap "rm -f $temp_file" EXIT SIGINT SIGTERM

# Build the gcloud command
fetch_cmd=(gcloud secrets versions access latest --secret="$secret_name")
add_cmd=(gcloud secrets versions add "$secret_name" --data-file="$temp_file")

if [[ -n "$project_id" ]]; then
  fetch_cmd+=(--project="$project_id")
  add_cmd+=(--project="$project_id")
fi

# Fetch the latest secret
echo "Fetching latest version of $secret_name..."
if ! "${fetch_cmd[@]}" > "$temp_file"; then
  echo "Error: Failed to fetch secret"
  exit 1
fi

# Edit in vim
vim "$temp_file";

echo;
cat "$temp_file" | jq;
echo;

# Confirm before uploading
echo -n "Add this as a new version? (y/N): "
read -r confirm
if [[ "$confirm" =~ ^[Yy]$ ]]; then
  "${add_cmd[@]}"
  echo "✓ New version added successfully"
else
  echo "Cancelled"
fi
